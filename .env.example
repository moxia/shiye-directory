# Public Supabase project values (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key used by `npm run admin:create`. Never expose or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical production origin, without a trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-time local administrator setup values
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-password
